{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuneChat",
  "version": "../package.json",
  "identifier": "dev.elinelson.runechat",
  "build": {
    "beforeDevCommand": "bun run tauri:dev:prepare",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run tauri:build:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RuneChat", "width": 1200, "height": 800, "minWidth": 390, "minHeight": 600, "resizable": true }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../.tauri/binaries/runechat-server"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "linux": { "appimage": { "bundleMediaFramework": false }, "deb": { "files": {} }, "rpm": { "files": {} } }
  }
}
