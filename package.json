{
  "name": "runechat",
  "version": "0.1.5",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "dev": "concurrently \"bun run server.ts\" \"vite --host\"",
    "build": "vite build",
    "start": "bun run server.ts",
    "server": "bun run server.ts",
    "client": "vite",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:sidecar": "bun run scripts/prepare-tauri-sidecar.ts",
    "tauri:dev:prepare": "bun run tauri:sidecar && vite --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:android:dev:prepare": "concurrently \"SERVER_PORT=3001 bun run server\" \"SERVER_PORT=3001 vite --host 0.0.0.0\"",
    "tauri:build:prepare": "bun run build && bun run tauri:sidecar",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.4",
    "svelte": "^5.56.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "ai": "^7.0.48",
    "dompurify": "^3.4.13",
    "marked": "^18.0.7",
    "prettier": "^3.9.6"
  }
}
